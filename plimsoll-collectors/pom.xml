<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.hasanyelaldi</groupId>
    <artifactId>plimsoll-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>plimsoll-collectors</artifactId>
  <name>Plimsoll Collectors</name>
  <description>Read resilience settings from real configuration and code into the Plimsoll model.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.hasanyelaldi</groupId>
      <artifactId>plimsoll-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- One knowledge base in the repository, served from the classpath (and the CLI jar) -->
      <resource>
        <directory>${project.basedir}/../kb/defaults</directory>
        <targetPath>kb/defaults</targetPath>
      </resource>
      <resource>
        <directory>${project.basedir}/../kb/detectors</directory>
        <targetPath>kb/detectors</targetPath>
      </resource>
    </resources>
  </build>

  <profiles>
    <!-- Differential oracles: real Spring Boot binds the same application.yml the collector reads.
         resilience4j-spring-boot4 exists from 2.4.0 on; skip with -DnoSpringOracle on older versions. -->
    <profile>
      <id>spring-oracle</id>
      <activation>
        <property>
          <name>!noSpringOracle</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-spring-boot4</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-timelimiter</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-aspectj</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework.cloud</groupId>
          <artifactId>spring-cloud-loadbalancer</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework</groupId>
          <artifactId>spring-webflux</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.projectreactor.netty</groupId>
          <artifactId>reactor-netty-http</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework.cloud</groupId>
          <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework.cloud</groupId>
          <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
          <scope>test</scope>
          <exclusions>
            <!-- resilience4j-spring-boot4 above is the Boot 4 one; both register the same beans -->
            <exclusion>
              <groupId>io.github.resilience4j</groupId>
              <artifactId>resilience4j-spring-boot3</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>no-spring-oracle</id>
      <activation>
        <property>
          <name>noSpringOracle</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testExcludes>
                <testExclude>**/oracle/**</testExclude>
              </testExcludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
